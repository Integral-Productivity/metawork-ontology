    "vertical_development_stage": { "@id": "mw:verticalDevelopmentStage", "@type": "@id" },
    "cynefin_domain": { "@id": "mw:cynefinDomain", "@type": "@id" },
    "neurological_level": { "@id": "mw:neurologicalLevel", "@type": "@id" },
    "perspective_checks": { "@id": "mw:perspectiveCheck", "@type": "@id", "@container": "@set" },
